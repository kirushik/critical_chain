<%# Replace the title field only; the rest of the header (Sharing button) stays %>
<%= turbo_stream.replace "editable_estimation_#{@estimation.id}_title" do %>
  <%= editable_estimation_field(@estimation, :title, can_edit: policy(@estimation).update_metadata?) %>
<% end %>

<%# Replace the mode toggle (handles tracking_mode updates) %>
<%= turbo_stream.replace "mode_toggle" do %>
  <div id="mode_toggle">
    <%= render 'mode_toggle' %>
  </div>
<% end %>
